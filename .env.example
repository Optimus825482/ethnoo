# ═══════════════════════════════════════════════
# ShuttleCall — Environment Variables
# Copy to .env and adjust for your deployment
# All values below are production-ready defaults
# ═══════════════════════════════════════════════

# ── Database ──
DB_USER=postgres
DB_PASSWORD=shuttlecall_pass_change_me

# ── App Port (host) ──
APP_PORT=3016

# ── Auth ──
NEXTAUTH_SECRET=shuttlecall-dev-secret-change-in-production-32chars
NEXTAUTH_URL=https://shuttle.erkanerdem.online

# ── Public App ──
NEXT_PUBLIC_APP_NAME=ShuttleCall
NEXT_PUBLIC_APP_URL=https://shuttle.erkanerdem.online

