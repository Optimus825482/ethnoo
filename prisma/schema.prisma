generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  DRIVER
}

enum DriverStatus {
  ON_DUTY
  OFF_DUTY
}

enum BuggyStatus {
  AVAILABLE
  BUSY
  OFFLINE
  MAINTENANCE
}

enum RequestStatus {
  PENDING
  ACCEPTED
  COMPLETED
  CANCELLED
  UNANSWERED
}

enum CancelledBy {
  DRIVER
  GUEST
  ADMIN
  SYSTEM
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  CLICKED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationType {
  NEW_REQUEST
  REQUEST_ACCEPTED
  REQUEST_COMPLETED
  REQUEST_CANCELLED
  REQUEST_TIMEOUT
  DRIVER_STATUS
}

model Hotel {
  id             Int      @id @default(autoincrement())
  code           String   @unique @db.VarChar(20)
  name           String   @db.VarChar(255)
  logo           String?  @db.Text
  timezone       String   @default("Europe/Istanbul") @db.VarChar(50)
  address        String?  @db.Text
  phone          String?  @db.VarChar(50)
  email          String?  @db.VarChar(255)
  isActive       Boolean  @default(true) @map("is_active")
  setupCompleted Boolean  @default(false) @map("setup_completed")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  users         User[]
  locations     Location[]
  buggies       Buggy[]
  requests      BuggyRequest[]
  auditLogs     AuditTrail[]
  notifications NotificationLog[]

  @@map("hotels")
}

model User {
  id                 Int       @id @default(autoincrement())
  hotelId            Int       @map("hotel_id")
  username           String    @unique @db.VarChar(50)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  role               UserRole
  fullName           String    @map("full_name") @db.VarChar(255)
  email              String?   @db.VarChar(255)
  phone              String?   @db.VarChar(50)
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  fcmToken           String?   @map("fcm_token") @db.VarChar(500)
  fcmTokenDate       DateTime? @map("fcm_token_date")
  pushSubscription   String?   @map("push_subscription") @db.Text
  driverStatus      DriverStatus @default(ON_DUTY) @map("driver_status")
  lastHeartbeat     DateTime? @map("last_heartbeat")
  lastGpsLat        Float?    @map("last_gps_lat")
  lastGpsLng        Float?    @map("last_gps_lng")
  lastGpsAt         DateTime? @map("last_gps_at")
  lastLogin          DateTime? @map("last_login")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  hotel             Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  buggyAssociations BuggyDriver[]
  acceptedRequests  BuggyRequest[] @relation("AcceptedByDriver")
  auditLogs         AuditTrail[]
  sessions          Session[]

  @@index([hotelId])
  @@index([role])
  @@index([isActive])
  @@index([driverStatus])
  @@map("users")
}

model Location {
  id           Int      @id @default(autoincrement())
  hotelId      Int      @map("hotel_id")
  name         String   @db.VarChar(255)
  description  String?  @db.Text
  logo         String?  @db.Text
  latitude     Decimal? @db.Decimal(10, 8)
  longitude    Decimal? @db.Decimal(11, 8)
  mapX         Int?     @map("map_x")
  mapY         Int?     @map("map_y")
  displayOrder Int      @default(0) @map("display_order")
  qrCodeData   String?  @map("qr_code_data") @db.VarChar(500)
  qrCodePath   String?  @map("qr_code_path") @db.VarChar(500)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  hotel              Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  buggies            Buggy[]
  requests           BuggyRequest[] @relation("RequestLocation")
  completionRequests BuggyRequest[] @relation("RequestCompletionLocation")

  @@index([hotelId])
  @@index([isActive])
  @@map("locations")
}

model Buggy {
  id                Int         @id @default(autoincrement())
  hotelId           Int         @map("hotel_id")
  code              String      @unique @db.VarChar(50)
  model             String?     @db.VarChar(100)
  licensePlate      String?     @map("license_plate") @db.VarChar(50)
  icon              String?     @db.VarChar(10)
  status            BuggyStatus @default(AVAILABLE)
  currentLocationId Int?        @map("current_location_id")
  isActive          Boolean     @default(true) @map("is_active")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  hotel           Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  currentLocation Location?      @relation(fields: [currentLocationId], references: [id], onDelete: SetNull)
  drivers         BuggyDriver[]
  requests        BuggyRequest[]

  @@index([hotelId])
  @@index([status])
  @@index([currentLocationId])
  @@map("buggies")
}

model BuggyDriver {
  id           Int       @id @default(autoincrement())
  buggyId      Int       @map("buggy_id")
  driverId     Int       @map("driver_id")
  isActive     Boolean   @default(true) @map("is_active")
  isPrimary    Boolean   @default(false) @map("is_primary")
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  unassignedAt DateTime? @map("unassigned_at")
  lastActiveAt DateTime? @map("last_active_at")

  buggy  Buggy @relation(fields: [buggyId], references: [id], onDelete: Cascade)
  driver User  @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([buggyId, driverId])
  @@index([buggyId])
  @@index([driverId])
  @@index([isActive])
  @@map("buggy_drivers")
}

model BuggyRequest {
  id                     Int           @id @default(autoincrement())
  hotelId                Int           @map("hotel_id")
  locationId             Int           @map("location_id")
  completionLocationId   Int?          @map("completion_location_id")
  buggyId                Int?          @map("buggy_id")
  acceptedById           Int?          @map("accepted_by_id")
  guestName              String?       @map("guest_name") @db.VarChar(255)
  roomNumber             String?       @map("room_number") @db.VarChar(50)
  hasRoom                Boolean       @default(true) @map("has_room")
  phone                  String?       @db.VarChar(50)
  notes                  String?       @db.Text
  guestFcmToken          String?       @map("guest_fcm_token") @db.VarChar(500)
  guestFcmTokenExpiresAt DateTime?     @map("guest_fcm_token_expires_at")
  guestPushSubscription  String?       @map("guest_push_subscription") @db.Text
  guestCapabilityHash    String?       @unique @map("guest_capability_hash") @db.VarChar(64)
  guestSseTicketHash     String?       @unique @map("guest_sse_ticket_hash") @db.VarChar(64)
  guestSseTicketExpiresAt DateTime?    @map("guest_sse_ticket_expires_at")
  guestSseTicketUsedAt   DateTime?     @map("guest_sse_ticket_used_at")
  status                 RequestStatus @default(PENDING)
  cancelledBy            CancelledBy?  @map("cancelled_by")
  requestedAt            DateTime      @default(now()) @map("requested_at")
  acceptedAt             DateTime?     @map("accepted_at")
  completedAt            DateTime?     @map("completed_at")
  cancelledAt            DateTime?     @map("cancelled_at")
  timeoutAt              DateTime?     @map("timeout_at")
  responseTime           Int?          @map("response_time")
  completionTime         Int?          @map("completion_time")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  hotel              Hotel            @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  location           Location         @relation("RequestLocation", fields: [locationId], references: [id], onDelete: Restrict)
  completionLocation Location?        @relation("RequestCompletionLocation", fields: [completionLocationId], references: [id], onDelete: SetNull)
  buggy              Buggy?           @relation(fields: [buggyId], references: [id], onDelete: SetNull)
  acceptedByDriver   User?            @relation("AcceptedByDriver", fields: [acceptedById], references: [id], onDelete: SetNull)
  notifications      NotificationLog[]

  @@index([hotelId])
  @@index([locationId])
  @@index([buggyId])
  @@index([acceptedById])
  @@index([status])
  @@index([requestedAt])
  @@map("buggy_requests")
}

model AuditTrail {
  id         Int      @id @default(autoincrement())
  hotelId    Int      @map("hotel_id")
  userId     Int?     @map("user_id")
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   Int?     @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([hotelId])
  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_trail")
}

model Session {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  tokenHash    String    @unique @map("token_hash") @db.VarChar(64)
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  userAgent    String?   @map("user_agent") @db.Text
  isActive     Boolean   @default(true) @map("is_active")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastActivity DateTime  @default(now()) @map("last_activity")
  revokedAt    DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@index([expiresAt])
  @@map("sessions")
}

model NotificationLog {
  id               Int                  @id @default(autoincrement())
  hotelId          Int                  @map("hotel_id")
  requestId        Int?                 @map("request_id")
  userId           Int?                 @map("user_id")
  notificationType NotificationType     @map("notification_type")
  title            String               @db.VarChar(255)
  body             String?              @db.Text
  priority         NotificationPriority @default(NORMAL)
  status           NotificationStatus   @default(PENDING)
  token            String?              @db.VarChar(500)
  errorMessage     String?              @map("error_message") @db.Text
  retryCount       Int                  @default(0) @map("retry_count")
  sentAt           DateTime?            @map("sent_at")
  deliveredAt      DateTime?            @map("delivered_at")
  clickedAt        DateTime?            @map("clicked_at")
  createdAt        DateTime             @default(now()) @map("created_at")

  hotel   Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  request BuggyRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([hotelId])
  @@index([requestId])
  @@index([status])
  @@index([createdAt])
  @@map("notification_logs")
}

model SystemSetting {
  id        Int      @id @default(autoincrement())
  hotelId   Int?     @map("hotel_id")
  key       String   @db.VarChar(100)
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([hotelId, key])
  @@map("system_settings")
}
