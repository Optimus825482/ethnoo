    "test:watch": "vitest",
    "seed": "tsx prisma/seed.ts",
    "seed:map": "tsx scripts/seed-map-coordinates.ts",
    "worker": "tsx src/workers/index.ts",
    "audit:prod": "npm audit --production --audit-level high"
  },
