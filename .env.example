# ShuttleCall environment variables
DB_USER=postgres
DB_PASSWORD=shuttlecall_pass_change_me
APP_PORT=3016

# Server database URL (required outside Docker Compose)
DATABASE_URL=postgresql://postgres:shuttlecall_pass_change_me@localhost:5432/shuttlecall?schema=public

# Auth
NEXTAUTH_SECRET=CHANGE_ME_MINIMUM_32_CHAR_SECRET
NEXTAUTH_URL=http://localhost:3016

# Initial setup API credential (minimum 32 high-entropy characters)
SETUP_SECRET=CHANGE_ME_MINIMUM_32_CHAR_SETUP_SECRET

# Public app
NEXT_PUBLIC_APP_NAME=ShuttleCall
NEXT_PUBLIC_APP_URL=http://localhost:3016
NEXT_PUBLIC_VAPID_PUBLIC_KEY=CHANGE_ME_VAPID_PUBLIC_KEY

# Web Push
VAPID_PUBLIC_KEY=CHANGE_ME_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=CHANGE_ME_VAPID_PRIVATE_KEY
VAPID_CONTACT_EMAIL=admin@example.com
